#!/bin/sh
# Two related jobs, both about never shipping a stale asset:
#   1. Stamp sw.js CACHE_NAME + version.json (below).
#   2. Bump the ?v= cache-buster on gm.css/gm.js references (bottom of file).
#
# Auto-stamp sw.js CACHE_NAME (and version.json) with a fresh timestamp on
# every commit that touches a file the service worker caches, or a file
# whose inline JS/CSS ships to users — sw.js itself, any *.html (inline
# JS/CSS), any file in PRECACHE_URLS (nav.js, pwa.js, mobile.css,
# manifest.json, icons/*), or any other top-level *.js/*.css. Without this,
# a deploy that changes e.g. portal.html but not sw.js leaves the old
# service worker in control forever, since browsers only refetch sw.js when
# it changes byte-for-byte. See sw.js comment above CACHE_NAME.
#
# Tracked copy: scripts/pre-commit (installed via scripts/install-hooks.sh)
# — this file lives only in .git/hooks/ and does NOT survive a fresh clone.

# ---------------------------------------------------------------------------
# iOS drift guard — runs FIRST, before any stamping, so a blocked commit
# leaves nothing half-rewritten behind it. See scripts/check-ios-drift.sh for
# why the iOS copy cannot simply be overwritten from root.
# ---------------------------------------------------------------------------
if [ -x scripts/check-ios-drift.sh ]; then
  sh scripts/check-ios-drift.sh || exit 1
fi

STAGED=$(git diff --cached --name-only)

TRIGGER=0
if echo "$STAGED" | grep -qx "sw.js"; then TRIGGER=1; fi
if echo "$STAGED" | grep -qE '\.html$'; then TRIGGER=1; fi
if echo "$STAGED" | grep -qE '^[^/]+\.(js|css)$'; then TRIGGER=1; fi
if echo "$STAGED" | grep -qE '^icons/(icon-192\.png|icon-512\.png|icon-maskable-512\.png|apple-touch-icon\.png)$'; then TRIGGER=1; fi
if echo "$STAGED" | grep -qx "manifest.json"; then TRIGGER=1; fi

if [ "$TRIGGER" = "1" ]; then
  STAMP=$(date +%s)
  sed -i '' -E 's/apex-static-[a-z0-9]+/apex-static-'"$STAMP"'/' sw.js
  printf '{"version": "%s"}\n' "$STAMP" > version.json
  git add sw.js version.json

  # ios/App/App/public/ is a REAL third copy of the frontend, not build output.
  # Stamping only the root copies left the iOS ones one stamp behind after
  # every single commit -- the hook runs after staging, so a sync done by hand
  # in the same commit is immediately stale. Stamp both, always.
  if [ -f ios/App/App/public/sw.js ]; then
    sed -i '' -E 's/apex-static-[a-z0-9]+/apex-static-'"$STAMP"'/' ios/App/App/public/sw.js
    git add ios/App/App/public/sw.js
  fi
  if [ -f ios/App/App/public/version.json ]; then
    printf '{"version": "%s"}\n' "$STAMP" > ios/App/App/public/version.json
    git add ios/App/App/public/version.json
  fi
fi

# Bump the ?v= cache-buster on <link>/<script> references to versioned assets.
# CACHE_NAME stamping alone is NOT enough for these: sw.js serves .js/.css
# stale-while-revalidate, so a page whose asset URL never changes renders one
# load behind forever. portal.html hit exactly this — its gm.css/gm.js were
# unversioned while the HTML shell (never cached) updated instantly, so the
# client portal showed an old design while admin pages were correct.
# A changed file must mean a changed URL. See sw.js's fetch handler.
# scheduling-queue.js/.css are here for the same reason the others are: both
# are in sw.js's PRECACHE_URLS and are served CACHE-FIRST, which sw.js states
# is only safe because every JS/CSS URL carries a ?v= stamp. They shipped
# referenced with no ?v= at all, so the cached copy could outlive its own
# CACHE_NAME bump. A changed file must mean a changed URL.
VERSIONED_ASSETS="gm.css gm.js calendar-grid.js calendar-grid.css gm-labels.js scheduling-queue.js scheduling-queue.css template-edit.js template-edit.css"

# The test below was once `grep -qx "$ASSET"` — an EXACT whole-line match. That
# meant staging ios/App/App/public/gm.js matched nothing, the entire block was
# skipped, and the iOS bundle shipped new code behind an UNCHANGED ?v=, which
# a cache-first service worker will happily serve stale forever. Match either
# the root path or the iOS copy of the same asset.
for ASSET in $VERSIONED_ASSETS; do
  # Dots escaped: in an -E pattern "gm.js" would also match "gmxjs".
  ARX=$(echo "$ASSET" | sed 's/\./\\./g')
  if ! echo "$STAGED" | grep -qxE "($ARX|ios/App/App/public/$ARX)"; then continue; fi

  ASTAMP=$(date +%s)
  ESCAPED=$(echo "$ASSET" | sed 's/\./\\./g')

  # Rewrite every reference across all tracked HTML, whether it already
  # carries a ?v= or not, so a newly added unversioned reference self-heals.
  for HTML in $(git ls-files '*.html'); do
    if ! grep -q "$ESCAPED" "$HTML"; then continue; fi
    sed -i '' -E 's|(["/])'"$ESCAPED"'(\?v=[0-9]+)?(["#])|\1'"$ASSET"'?v='"$ASTAMP"'\3|g' "$HTML"
    git add "$HTML"
  done
done
